 167              	                .macro  CRT0_SET_VBAR_SYMBOL source
 168              	#if CRT0_VBAR_INIT == TRUE
 169              	                ldr     r0, =\source
 170              	                mcr     p15, 0, r0, c12, c0, 0
 171              	                dsb
 172              	                isb
 173              	#endif
 174              	                .endm
 175              	
 176              	                .macro  CRT0_SET_VBAR_REG reg
 177              	#if CRT0_VBAR_INIT == TRUE
 178              	                mcr     p15, 0, \reg, c12, c0, 0
 179              	                dsb
 180              	                isb
 181              	#endif
 182              	                .endm
 183              	
 184              	                .macro  CRT0_SETUP_FPU
 185              	#if CRT0_INIT_FPU == TRUE
 186              	                mrc     p15, 0, r0, c1, c0, 2
 187              	                ldr     r1, =CPACR_CP10_CP11_FULL_ACCESS
 188              	                orr     r0, r0, r1
 189              	                mcr     p15, 0, r0, c1, c0, 2
 190              	                isb
 191              	
 192              	                vmrs    r0, fpexc
 193              	                ldr     r1, =FPEXC_EN
 194              	                orr     r0, r0, r1
 195              	                vmsr    fpexc, r0
 196              	
 197              	                ldr     r0, =CRT0_FPSCR_INIT
 198              	                vmsr    fpscr, r0
 199              	#endif
 200              	                .endm
 201              	
 202              	                .macro  CRT0_COPY_VECTORS
 203              	#if CRT0_INIT_VECTORS == TRUE
 204              	                ldr     r1, =__textvectors_base__
 205              	                ldr     r2, =__vectors_base__
 206              	                ldr     r3, =__vectors_end__
 207              	                mov     r4, r2
 208              	1:
 209              	                cmp     r2, r3
 210              	                bhs     2f
 211              	                ldr     r0, [r1], #4
 212              	                str     r0, [r2], #4
 213              	                b       1b
 214              	2:
 215              	                CRT0_SET_VBAR_REG r4
 216              	#endif
 217              	                .endm
