  85              	/*
  86              	 * Common IRQ entry point.
  87              	 *
  88              	 * The interrupt-controller specific code is centralized in
  89              	 * __port_irq_dispatch(), which is expected to claim, dispatch and complete
  90              	 * the current interrupt. It returns non-zero when preemption is required.
  91              	 *
  92              	 * System stack frame structure after a context switch in the interrupt handler:
  93              	 *
ARM GAS  /tmp/ccqhJp5d.s 			page 4


  94              	 * High +------------+
  95              	 *      |   LR_USR   | -+
  96              	 *      |     r12    |  |
  97              	 *      |     r3     |  |
  98              	 *      |     r2     |  | External context: IRQ handler frame
  99              	 *      |     r1     |  |
 100              	 *      |     r0     |  |
 101              	 *      |   LR_IRQ   |  |   (user code return address)
 102              	 *      |   PSR_USR  | -+   (user code status)
 103              	 *      |    ....    | <- chSchDoReschedule() stack frame
 104              	 *      |     LR     | -+   (system code return address)
 105              	 *      |     r11    |  |
 106              	 *      |     r10    |  |
 107              	 *      |     r9     |  |
 108              	 *      |     r8     |  | Internal context: chSysSwitch() frame
 109              	 *      |     r7     |  |
 110              	 *      |     r6     |  |
 111              	 *      |     r5     |  |
 112              	 * SP-> |     r4     | -+
 113              	 * Low  +------------+
 114              	 */
 115 0028 00F020E3 	                .balign 16
 115      00F020E3 
 116              	                .global Irq_Handler
 117              	Irq_Handler:
 118 0030 0F502DE9 	                stmfd   sp!, {r0-r3, r12, lr}
 119 0034 FEFFFFEB 	                bl      __port_irq_dispatch
 120 0038 000050E3 	                cmp     r0, #0
 121 003c 0F50BDE8 	                ldmfd   sp!, {r0-r3, r12, lr}
 122 0040 0E00000A 	                beq     .Lirq_return
 123              	
 124              	                /* Now the frame is created in the system stack, the IRQ
 125              	                   stack is empty.*/
 126 0044 9FF021E3 	                msr     CPSR_c, #(MODE_SYS | I_BIT)
 127 0048 0F502DE9 	                stmfd   sp!, {r0-r3, r12, lr}
 128 004c 92F021E3 	                msr     CPSR_c, #(MODE_IRQ | I_BIT)
 129 0050 00004FE1 	                mrs     r0, SPSR
 130 0054 0E10A0E1 	                mov     r1, lr
 131 0058 9FF021E3 	                msr     CPSR_c, #(MODE_SYS | I_BIT)
 132 005c 03002DE9 	                stmfd   sp!, {r0, r1}
 133              	
 134              	                /* Context switch.*/
 135              	#if CH_DBG_SYSTEM_STATE_CHECK
 136              	                bl      __dbg_check_lock
 137              	#endif
 138 0060 FEFFFFEB 	                bl      chSchDoPreemption
 139              	#if CH_DBG_SYSTEM_STATE_CHECK
 140              	                bl      __dbg_check_unlock
 141              	#endif
 142              	
 143              	                /* Re-establish the IRQ conditions again.*/
 144 0064 0300BDE8 	                ldmfd   sp!, {r0, r1}
 145 0068 92F021E3 	                msr     CPSR_c, #(MODE_IRQ | I_BIT)
 146 006c 00F06FE1 	                msr     SPSR_fsxc, r0
 147 0070 01E0A0E1 	                mov     lr, r1
 148 0074 9FF021E3 	                msr     CPSR_c, #(MODE_SYS | I_BIT)
 149 0078 0F50BDE8 	                ldmfd   sp!, {r0-r3, r12, lr}
